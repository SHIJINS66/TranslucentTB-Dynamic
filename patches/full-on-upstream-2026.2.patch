+
 	for (auto& [handle, info] : m_Taskbars)
 	{
-		if (sender == info.background.control && !info.background.originalFill)
-		{
-			info.background.originalFill = info.background.control.Fill();
+		if (sender == info.background.control)
+		{
+			if (!info.background.originalFill)
+			{
+				info.background.originalFill = info.background.control.Fill();
+			}
+
+			// The shell rewrites the bar's Fill on events like opening a
+			// thumbnail flyout. Restore our cached gradient right here instead
+			// of waiting for the next sample tick, otherwise the bar flashes
+			// back to its stock look for a frame.
+			const HWND taskbar = GetAncestor(info.window, GA_PARENT);
+			if (const auto brush = m_GradientBrushes.find(taskbar); brush != m_GradientBrushes.end() && brush->second)
+			{
+				m_ApplyingFill = true;
+				info.background.control.Fill(brush->second);
+				m_ApplyingFill = false;
+			}
 		}
 	}
 }
