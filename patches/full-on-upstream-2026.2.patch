+HRESULT TaskbarAppearanceService::SetTaskbarGradient(HWND taskbar, UINT count, UINT *colors, FLOAT *offsets) try
+{
+	if (!colors || !offsets || count < 2)
+	{
+		return E_INVALIDARG;
+	}
+
+	if (const auto info = GetTaskbarInfo(taskbar))
+	{
+		if (info->background.control && info->background.originalFill)
+		{
+			// A single horizontal gradient brush gives us an "ambient light" bar:
+			// each sampled zone becomes a colour stop and XAML interpolates
+			// smoothly between them.
+			//
+			// The brush is created once and then mutated in place: re-assigning a
+			// brand new brush 30 times per second forces the compositor to
+			// recomposite the bar and shows up as flicker on video content.
+			auto &cachedBrush = m_GradientBrushes[taskbar];
+			auto &cachedStops = m_GradientStopCounts[taskbar];
+			if (!cachedBrush || cachedStops != count)
+			{
+				wux::Media::LinearGradientBrush brush;
+				brush.StartPoint({ 0.0f, 0.5f });
+				brush.EndPoint({ 1.0f, 0.5f });
+
+				auto stops = brush.GradientStops();
+				for (UINT i = 0; i < count; ++i)
+				{
+					wux::Media::GradientStop stop;
+					stop.Color(Util::Color::FromABGR(colors[i]));
+					stop.Offset(std::clamp(offsets[i], 0.0f, 1.0f));
+					stops.Append(stop);
+				}
+
+				cachedBrush = brush;
+				cachedStops = count;
+				m_ApplyingFill = true;
+				info->background.control.Fill(brush);
+				m_ApplyingFill = false;
+			}
+			else
+			{
+				auto stops = cachedBrush.GradientStops();
+				for (UINT i = 0; i < count; ++i)
+				{
+					stops.GetAt(i).Color(Util::Color::FromABGR(colors[i]));
+				}
+			}
 		}
 	}
 
