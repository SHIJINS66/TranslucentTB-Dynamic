+void MainAppWindow::DynamicTintSettingsRequested()
+{
+	std::unique_lock lock(m_PickerMutex);
+	if (m_DynamicSettingsHost)
+	{
+		SetForegroundWindow(m_DynamicSettingsHost->handle());
+		return;
+	}
+	const auto &tint = m_App.GetConfigManager().GetConfig().DynamicTint;
+	const int samples = tint.SampleInterval > 0 ? std::clamp(1000 / tint.SampleInterval, 1, 60) : tint.SamplesPerSecond;
+	using winrt::TranslucentTB::Xaml::Pages::DynamicTintSettingsPage;
+	m_App.CreateXamlWindow<DynamicTintSettingsPage>(xaml_startup_position::mouse,
+		[this, innerLock = std::move(lock)](const DynamicTintSettingsPage &panel, BaseXamlPageHost *host) mutable
+		{
+			m_DynamicSettingsHost = host;
+			innerLock.unlock();
+			auto closeRevoker = panel.Closed(winrt::auto_revoke, [this]
+			{
+				m_App.DispatchToMainThread([this]
+				{
+					std::scoped_lock guard(m_PickerMutex);
+					m_DynamicSettingsHost = nullptr;
+				});
+			});
+			panel.ParametersCommitted([this, revoker = std::move(closeRevoker)](int32_t zones, int32_t fps, int32_t sampling, int32_t depth, bool adaptiveSampling) mutable
+			{
+				revoker.revoke();
+				m_App.DispatchToMainThread([this, zones, fps, sampling, depth, adaptiveSampling]
+				{
+					auto &manager = m_App.GetConfigManager();
+					ApplyDynamicTintPanelSettings(manager.GetConfig().DynamicTint, zones, fps, sampling, depth, adaptiveSampling);
+					m_App.GetWorker().ConfigurationChanged();
+					manager.SaveConfig();
+					std::scoped_lock guard(m_PickerMutex);
+					m_DynamicSettingsHost = nullptr;
+				});
+			});
+		}, tint.Zones, tint.Fps, samples, tint.SampleDepth, tint.AdaptiveSampling);
+}
+
+void MainAppWindow::DynamicTintChanged(bool enabled)
+{
+	auto &manager = m_App.GetConfigManager();
+	manager.GetConfig().DynamicTint.Enabled = enabled;
+	m_App.GetWorker().ConfigurationChanged();
+	manager.SaveConfig();
 }
 
